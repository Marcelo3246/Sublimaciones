# ============================================================
# DLL Sublimados — Variables de entorno del frontend
# Copiar a .env y ajustar. Vite solo expone las variables VITE_*.
# ============================================================

# URL base de la API REST.
# En desarrollo se deja vacío: la SPA usa el proxy de Vite (/api -> Django).
VITE_API_URL=/api/v1

# Backend al que apunta el proxy de Vite en desarrollo.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Login simulado en el navegador, para trabajar sin el backend levantado.
# true  = usuario de prueba admin / admin123
# false = usa POST /api/v1/auth/token/ del backend Django
VITE_AUTH_MOCK=false
