# URL base de la API del backend Django
VITE_API_URL=http://localhost:8000/api/v1

# Login: true = simulado en el navegador (usuario admin / admin123)
#        false = llama a POST /auth/token/ del backend
VITE_AUTH_MOCK=true

# Datos de los módulos: true = simulados en el navegador, false = todo contra el backend
VITE_API_MOCK=true

# Módulos que ya usan el backend real aunque VITE_API_MOCK siga en true (separados por coma).
# Nombres: dashboard, inventario, ventas, compras, clientes, proveedores, reportes, historial, auditoria, usuarios
VITE_API_REALES=

# Local (sucursal) que se envía al crear ventas, compras y movimientos si el token no trae uno
VITE_LOCAL_ID=1
