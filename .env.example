# ============================================================
# DLL Sublimados — Variables de entorno
# Copiar a .env y ajustar valores para cada ambiente
#
#   cp .env.example .env
#
# .env está en .gitignore: nunca se versiona.
# ============================================================

# Django
# Generar una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiar-por-una-clave-secreta-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos
# PostgreSQL 14+ (RNF-02). Para una prueba rápida sin servidor, descomentar SQLite:
# DB_ENGINE=django.db.backends.sqlite3
# Con PostgreSQL, settings.py usa el motor por defecto para sustituirlo por el
# backend propio backend.common.pgschema (esquemas por módulo); no cambia nada.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dll_sublimados
# Credenciales locales de PostgreSQL. Ver database/00_crear_bd.sql
DB_USER=postgres
DB_PASSWORD=tu_contrasena_segura
DB_HOST=localhost
DB_PORT=5432

# CORS — orígenes del frontend React (Vite en dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tipo de cambio predeterminado USD → Bs
TASA_CAMBIO_DEFAULT=36.50

# ── Neon (Lakebase Postgres en la nube) ──────────────────────────────────────
# Generadas automáticamente con `neon init`. Ver: https://console.neon.tech
# Si DATABASE_URL está definida, settings.py la usa con prioridad sobre DB_*.
# Para desarrollo local sin Neon, dejar vacías y completar las vars DB_* de arriba.
#
# DATABASE_URL  → pooler PgBouncer  → usar en la app Django (conn_max_age=600)
# DATABASE_URL_UNPOOLED → endpoint directo → usar solo para migraciones:
#   DATABASE_URL=$DATABASE_URL_UNPOOLED python manage.py migrate
DATABASE_URL=postgresql://<user>:<pass>@<pooler-host>/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<pass>@<direct-host>/neondb?sslmode=require&channel_binding=require
NEON_BRANCH=production
NEON_BRANCH_ID=<branch-id>
NEON_FUNCTION_HOST_SUFFIX=.compute.<region>.aws.neon.tech
