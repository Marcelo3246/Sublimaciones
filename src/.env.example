# ============================================================
# DLL Sublimados — Variables de entorno
# Copiar a .env y ajustar valores para cada ambiente
# ============================================================

# Django
SECRET_KEY=cambiar-por-una-clave-secreta-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (por defecto PostgreSQL; para pruebas rápidas sin Postgres se puede usar sqlite)
# DB_ENGINE=django.db.backends.sqlite3
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dll_sublimados
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS — orígenes del frontend React
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tipo de cambio predeterminado USD → Bs
TASA_CAMBIO_DEFAULT=36.50
